{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MemoryManagement": {
    "DisposePatterns": {
      "Enable": true,
      "IDisposableImplementation": true,
      "UsingStatementsForDisposables": true,
      "ClearEventHandlers": true
    },
    "ResourceCleanup": {
      "ClearLargeCollections": true,
      "ProperDisposeNetworking": true,
      "FixByteArraysLeaks": true,
      "HandleHttpConnections": true,
      "DisposeLoggingScopes": true,
      "CancelTokensCleanup": true
    }
  }
}