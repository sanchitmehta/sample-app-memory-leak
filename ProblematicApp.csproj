using System;
using Microsoft.Extensions.Logging;

namespace ProblemApp.Logging
{
    public class CustomLogger : ILogger, IDisposable
    {
        private readonly string _categoryName;
        private readonly Action<string> _logAction;

        public CustomLogger(string categoryName, Action<string> logAction)
        {
            _categoryName = categoryName;
            _logAction = logAction;
        }

        public IDisposable BeginScope<TState>(TState state)
        {
            // Implement scope disposal pattern
            return default;
        }

        public bool IsEnabled(LogLevel logLevel)
        {
            // Implement the logic to determine if the logger is enabled
            return true;
        }

        public void Log<TState>(LogLevel logLevel, EventId eventId, 
            TState state, Exception? exception, Func<TState, Exception?, string> formatter)
        {
            if (!IsEnabled(logLevel))
            {
                return;
            }

            _logAction($"{logLevel}: {_categoryName} - {formatter(state, exception)}");
        }

        public void Dispose()
        {
            // Implement any required cleanup
        }
    }
}