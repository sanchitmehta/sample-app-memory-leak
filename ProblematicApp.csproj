using System;
using Microsoft.AspNetCore.Mvc;
using Microsoft.Extensions.Logging;
using System.Text;

namespace Problemapp.Controllers
{
    public class HomeController : Controller
    {
        private readonly ILogger<HomeController> _logger;

        public HomeController(ILogger<HomeController> logger)
        {
            _logger = logger;
        }

        public IActionResult Index()
        {
            byte[] data = null;
            StringBuilder strBuilder = null;

            try
            {
                data = new byte[1024];
                strBuilder = new StringBuilder();

                // Simulate some work with the data
                _logger.LogInformation("Index action invoked.");
                strBuilder.AppendLine("Hello, World!");

                return View();
            }
            finally
            {
                if (data != null)
                {
                    Array.Clear(data, 0, data.Length);
                }

                strBuilder?.Clear();
                strBuilder = null;
            }
        }

        protected override void Dispose(bool disposing)
        {
            if (disposing)
            {
                // Dispose any other disposable objects here
                _logger.LogInformation("Disposing HomeController");
            }
            base.Dispose(disposing);
        }
    }
}

