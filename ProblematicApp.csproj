<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

  <!-- Fixes for memory leaks scoped to findings -->

  <!-- Suggestion: Ensure efficient use of `System.Byte[]` arrays -->
  <!-- If any large byte arrays are used in the application:
       - Use ArrayPool<T> to rent and return byte arrays when possible.
       - Dispose of streams properly to release any associated buffers. -->

  <!-- Fix for `System.String` growth -->
  <!-- If many temporary string objects are being created, consider:
       - Using StringBuilder for concatenations.
       - Avoiding unnecessary string manipulations.
       - Using string interning where patterns of duplication are found. -->

  <!-- HTTP-related object leaks -->
  <!-- Use HttpClientFactory to prevent HttpClient socket exhaustion and ensure HttpClient is managed efficiently. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.1" />
  </ItemGroup>

  <!-- Logging scope growth fixes -->
  <!-- Ensure ILogger.BeginScope is used properly, and scopes are disposed to avoid memory growth. -->
  <!-- Review logging verbosity to avoid unintended retention of large logging data. -->

</Project>