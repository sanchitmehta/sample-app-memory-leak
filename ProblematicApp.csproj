using System;
using System.IO.Pipelines;

public class PipeHandling : IDisposable
{
    private readonly Pipe _pipe = new Pipe();

    public void AddToPipe(ReadOnlyMemory<byte> data)
    {
        _pipe.Writer.WriteAsync(data).AsTask().Wait();
    }

    public void Dispose()
    {
        _pipe.Writer.Complete();
        _pipe.Reader.Complete();
    }
}

