using System;
using System.Threading;
using System.Threading.Tasks;

public class CPUIntensiveTask : IDisposable
{
    private Task _task;
    private CancellationTokenSource _cts;

    public CPUIntensiveTask(Action action)
    {
        _cts = new CancellationTokenSource();
        _task = Task.Run(action, _cts.Token);
    }

    public void Stop()
    {
        _cts.Cancel();
    }

    public void Dispose()
    {
        _cts?.Dispose();
        _task?.Dispose();
    }
}

