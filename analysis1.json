using System;
using System.Collections.Concurrent;

public class CPUTaskManager : IDisposable
{
    private ConcurrentDictionary<string, CPUIntensiveTask> _activeTasks = new();

    public string StartNewTask(int complexity)
    {
        var id = Guid.NewGuid().ToString();
        var tokenSource = new CancellationTokenSource();
        var task = new CPUIntensiveTask(tokenSource);
        _activeTasks[id] = task;
        return id;
    }

    public void StopTask(string taskId)
    {
        if (_activeTasks.TryRemove(taskId, out var task))
        {
            task.Stop();
            task.Dispose();
        }
    }

    public ConcurrentDictionary<string, CPUIntensiveTask> GetActiveTasks()
    {
        return _activeTasks;
    }

    public void StopAllTasks()
    {
        foreach (var taskId in _activeTasks.Keys)
        {
            StopTask(taskId);
        }
        _activeTasks.Clear();
    }

    public void Dispose()
    {
        foreach (var task in _activeTasks.Values)
        {
            task.Dispose();
        }
        _activeTasks.Clear();
    }
}

