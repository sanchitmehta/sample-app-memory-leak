using Microsoft.AspNetCore.Mvc;
using ProblematicApp.Services;

[ApiController]
[Route("[controller]")]
public class MemoryController : ControllerBase
{
    private readonly ILeakyCache _cache;

    public MemoryController(ILeakyCache cache)
    {
        _cache = cache;
    }

    [HttpPost("add")]
    public IActionResult AddToCache([FromBody] CacheRequest request)
    {
        var data = new byte[request.SizeInMb * 1024 * 1024];
        _cache.AddToCache(request.Key, data);
        return Ok();
    }

    [HttpDelete("clear")]
    public IActionResult ClearCache()
    {
        _cache.Clear();
        return Ok();
    }
}

