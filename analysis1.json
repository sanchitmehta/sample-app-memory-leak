public class DataGenerator
{
    private readonly ILeakyCache _leakyCache;
    private readonly IEventManager _eventManager;

    public DataGenerator(ILeakyCache leakyCache, IEventManager eventManager)
    {
        _leakyCache = leakyCache;
        _eventManager = eventManager;
    }

    public void AddToCache(string key, int sizeInMb)
    {
        var data = new byte[sizeInMb * 1024 * 1024];
        _leakyCache.AddToCache(key, data);
    }

    public void Subscribe(string id)
    {
        _eventManager.Subscribe(id, (sender, args) => { /* handle event */ });
    }

    public void GenerateAndStoreData(string key, int sizeInMb)
    {
        var data = new byte[sizeInMb * 1024 * 1024];
        _leakyCache.AddToCache(key, data);
    }

    public void MemoryDump()
    {
        using (var process = System.Diagnostics.Process.Start("dotnet-dump", "collect"))
        {
            process?.WaitForExit();
        }
    }
}