using Microsoft.AspNetCore.Mvc;
using System;
using System.Threading.Tasks;

[ApiController]
[Route("[controller]")]
public class CPUController : ControllerBase
{
    private readonly CPUTaskManager _cpuTaskManager;

    public CPUController(CPUTaskManager cpuTaskManager)
    {
        _cpuTaskManager = cpuTaskManager;
    }

    [HttpPost]
    [Route("start")]
    public async Task<IActionResult> StartNewTask([FromBody] TaskRequest request)
    {
        _cpuTaskManager.StartNewTask(request.Complexity);

        return Ok();
    }

    [HttpPost]
    [Route("stop/{taskId}")]
    public IActionResult StopTask(Guid taskId)
    {
        _cpuTaskManager.StopTask(taskId);

        return Ok();
    }

    [HttpGet]
    [Route("active")]
    public IActionResult GetActiveTasks()
    {
        return Ok(_cpuTaskManager.GetActiveTasks());
    }

    [HttpPost]
    [Route("stopAll")]
    public IActionResult StopAllTasks()
    {
        _cpuTaskManager.StopAllTasks();

        return Ok();
    }
}

