using System.Collections.Concurrent;

public class LeakyCache : ILeakyCache, IDisposable
{
    private ConcurrentDictionary<string, byte[]> _cache = new();

    public void AddToCache(string key, byte[] data)
    {
        _cache[key] = data;
    }

    public void ClearCache()
    {
        _cache.Clear();
    }

    public void Dispose()
    {
        _cache.Clear();
        _cache = null;
    }
}