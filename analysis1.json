using Microsoft.AspNetCore.Mvc;

[ApiController]
[Route("api/[controller]")]
public class CPUController : ControllerBase
{
    private readonly CPUTaskManager _cpuTaskManager;

    public CPUController(CPUTaskManager cpuTaskManager)
    {
        _cpuTaskManager = cpuTaskManager;
    }

    [HttpPost("StartTask")]
    public IActionResult StartNewTask(TaskRequest request)
    {
        var taskId = _cpuTaskManager.StartNewTask(request.Complexity);
        return Ok(taskId);
    }

    [HttpPost("StopTask/{taskId}")]
    public IActionResult StopTask(string taskId)
    {
        _cpuTaskManager.StopTask(taskId);
        return Ok();
    }

    [HttpGet("ActiveTasks")]
    public IActionResult GetActiveTasks()
    {
        return Ok(_cpuTaskManager.GetActiveTasks().ToList());
    }

    [HttpPost("StopAllTasks")]
    public IActionResult StopAllTasks()
    {
        _cpuTaskManager.StopAllTasks();
        return Ok();
    }
}

