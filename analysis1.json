using System.Collections.Concurrent;

public class LeakyCache : ILeakyCache, IDisposable
{
    private readonly ConcurrentDictionary<string, byte[]> _cache = new();

    public void AddToCache(string key, byte[] data)
    {
        _cache[key] = data;
    }

    public void Clear()
    {
        _cache.Clear();
    }

    public void Dispose()
    {
        Clear();
    }
}

