using System;
using System.Collections.Concurrent;
using System.Linq;

public class CPUTaskManager : IDisposable
{
    private ConcurrentDictionary<Guid, CPUIntensiveTask> _activeTasks = new ConcurrentDictionary<Guid, CPUIntensiveTask>();

    public void StartNewTask(int complexity)
    {
        var taskId = Guid.NewGuid();
        var task = new CPUIntensiveTask(() =>
        {
            // Simulate some CPU intensive work
        });

        _activeTasks.TryAdd(taskId, task);
    }

    public void StopTask(Guid taskId)
    {
        if (_activeTasks.TryRemove(taskId, out var task))
        {
            task.Stop();
            task.Dispose();
        }
    }

    public ConcurrentDictionary<Guid, CPUIntensiveTask> GetActiveTasks()
    {
        return _activeTasks;
    }

    public void StopAllTasks()
    {
        var tasksToStop = _activeTasks.Keys.ToList();
        foreach (var taskId in tasksToStop)
        {
            StopTask(taskId);
        }
    }

    public void Dispose()
    {
        StopAllTasks();
        foreach (var task in _activeTasks.Values)
        {
            task.Dispose();
        }
        _activeTasks.Clear();
    }
}

