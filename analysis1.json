using System;

public class DataGenerator : IDisposable
{
    private readonly ILeakyCache _leakyCache;
    private readonly IEventManager _eventManager;
    private bool _disposed = false;

    public DataGenerator(ILeakyCache leakyCache, IEventManager eventManager)
    {
        _leakyCache = leakyCache;
        _eventManager = eventManager;
    }

    public void AddToCache(string key, byte[] data)
    {
        _leakyCache.AddToCache(key, data);
    }

    public void GenerateAndStoreData(string id, int sizeInMb)
    {
        var data = new byte[sizeInMb * 1024 * 1024];
        _leakyCache.AddToCache(id, data);
    }

    public void Subscribe(string id)
    {
        _eventManager.Subscribe($"Event_{id}", (x) => Console.WriteLine(x));
    }

    public void MemoryDump()
    {
        using (var process = System.Diagnostics.Process.Start("dump"))
        {
            process.WaitForExit();
        }
    }

    public void Dispose()
    {
        if (!_disposed)
        {
            _eventManager.UnsubscribeAll();
            _leakyCache.ClearCache();
            _disposed = true;
        }
    }
}

