using System.Collections.Concurrent;

public class CPUTaskManager : IDisposable
{
    private readonly ConcurrentDictionary<string, CPUIntensiveTask> _activeTasks = new();

    public void StartNewTask(int complexity)
    {
        var task = new CPUIntensiveTask(complexity);
        _activeTasks.TryAdd(task.Id, task);
        task.Start();
    }

    public void StopTask(string taskId)
    {
        if (_activeTasks.TryRemove(taskId, out var task))
        {
            task.Stop();
            task.Dispose();
        }
    }

    public IEnumerable<CPUIntensiveTask> GetActiveTasks()
    {
        return _activeTasks.Values.ToArray();
    }

    public void StopAllTasks()
    {
        foreach (var task in _activeTasks.Values)
        {
            task.Stop();
            task.Dispose();
        }
        _activeTasks.Clear();
    }

    public void Dispose()
    {
        StopAllTasks();
    }
}

