{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        },
        "DisposeOnClose": true
    },
    "AllowedHosts": "*",
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://0.0.0.0:5877"
            }
        },
        "Limits": {
            "MaxConcurrentConnections": 100,
            "MaxConcurrentUpgradedConnections": 100,
            "KeepAliveTimeout": 120.0
        },
        "DisposeSocketsOnShutdown": true
    },
    "GarbageCollection": {
        "DisposeByteArraysExplicitly": true,
        "DisposeStringsExplicitly": true,
        "Config": {
            "ClearLargeCollections":"OnRelease"
        }
    },
    "Networking": {
        "AddressManagement": {
            "EnableEndPointCleanup": true,
            "DisposeUnusedSockets": true
        }
    },
    "CancellationTokens": {
        "DisposeProperly": {
            "Enable": true,
            "Settings": {
                "DisposeWhenNoLongerNeeded": true
            }
        }
    },
    "ObjectManagement": {
        "DisposePattern": {
            "Enable": true,
            "Settings": {
                "ForceFinalizerRun": false,
                "Defaults": true
            }
        }
    }
}